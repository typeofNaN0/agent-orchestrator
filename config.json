    "max_infrastructure_retries": 1,
    "max_repair_rounds": 2,
    "max_repairs_per_round": 3,
    "max_total_attempts": 30,
    "max_run_seconds": 14400,
    "max_observed_tokens": 1000000,
    "stall_seconds": 600,
    "poll_seconds": 0.2,
    "repeated_failure_limit": 2,
    "reuse_sidekick_threads": false,
    "ladder": [
      {
        "model": "luna",
        "effort": "medium"
      },
      {
        "model": "luna",
        "effort": "high"
      },
      {
        "model": "sol",
        "effort": "high"
      },
      {
        "model": "astra",
        "effort": "high"
      }
    ]
  },
  "task_type_routes": {},
  "checks": {},
