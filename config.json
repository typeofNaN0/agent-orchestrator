      "type": "codex",
      "command": [
        "codex"
      ],
      "config": {}
    }
  },
  "models": {
    "luna": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "efforts": [
        "none",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Focused, mechanical, well-specified work and test execution"
    },
    "sol": {
      "provider": "codex",
      "model": "gpt-6-sol",
      "efforts": [
        "none",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Implementation, debugging, and tasks needing substantial reasoning"
    },
    "astra": {
      "provider": "codex",
