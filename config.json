{
  "version": 1,
  "max_sidekicks": 6,
  "max_parallel": 3,
  "timeout_seconds": 1800,
  "max_context_chars": 48000,
  "max_report_chars": 16000,
  "max_prompt_chars": 180000,
  "workspace_mode": "worktrees",
  "discovery": {
    "enabled": true,
    "allow_skip": false,
    "model": "sol",
    "effort": "medium",
    "max_sessions": 2,
    "max_follow_up_rounds": 1
  },
  "adaptive": {
